// Одноразовый bootstrap namespace cv-portfolio.
// Запускать вручную в Jenkins (не привязывать к webhook).
pipeline {
  agent any

  environment {
    NS = 'cv-portfolio'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Namespace') {
      steps {
        withKubeConfig([credentialsId: 'kubeconfig']) {
          sh 'kubectl apply -f k8s/namespace.yaml'
        }
      }
    }

    stage('Secrets') {
      steps {
        withKubeConfig([credentialsId: 'kubeconfig']) {
          withCredentials([
            file(credentialsId: 'cv-backend-env', variable: 'BACKEND_ENV_FILE'),
            usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')
          ]) {
            sh '''
              kubectl create secret generic cv-backend-secret \
                --namespace=${NS} \
                --from-env-file=${BACKEND_ENV_FILE} \
                --dry-run=client -o yaml | kubectl apply -f -

              kubectl create secret docker-registry dockerhub-secret \
                --namespace=${NS} \
                --docker-server=https://index.docker.io/v1/ \
                --docker-username=${DOCKER_USER} \
                --docker-password=${DOCKER_PASS} \
                --dry-run=client -o yaml | kubectl apply -f -
            '''
          }
        }
      }
    }

    stage('PostgreSQL') {
      steps {
        withKubeConfig([credentialsId: 'kubeconfig']) {
          sh '''
            kubectl apply -f k8s/pvc/postgres-pvc.yaml
            kubectl apply -f k8s/deployments/postgres-statefulset.yaml
            kubectl apply -f k8s/services/postgres-svc.yaml
            kubectl rollout status statefulset/postgres -n ${NS} --timeout=300s
          '''
        }
      }
    }

    stage('Applications') {
      steps {
        withKubeConfig([credentialsId: 'kubeconfig']) {
          sh '''
            kubectl apply -f k8s/services/
            kubectl apply -f k8s/deployments/cv-backend-deploy.yaml
            kubectl apply -f k8s/deployments/cv-frontend-deploy.yaml
            kubectl apply -f k8s/deployments/cv-contact-me-deploy.yaml
            kubectl apply -f k8s/ingress/ingress.yaml
          '''
        }
      }
    }

    stage('Verify') {
      steps {
        withKubeConfig([credentialsId: 'kubeconfig']) {
          sh '''
            kubectl get pods -n ${NS}
            kubectl get ingress -n ${NS}
          '''
        }
      }
    }
  }

  post {
    success {
      echo 'Bootstrap complete. Push Docker images via cv/cv-backend CD pipelines.'
    }
    failure {
      echo 'Bootstrap failed!'
    }
  }
}
